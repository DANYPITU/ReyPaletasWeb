{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/private/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/ping",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ],
  "crons": [
    {
      "path": "/ping",
      "schedule": "0 6 */3 * *"
    }
  ]
}
