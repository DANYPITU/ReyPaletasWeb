{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ping",
      "destination": "https://REY-PALETAS-BACK.vercel.app/ping"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/ping",
      "schedule": "0 6 */3 * *"
    }
  ]
}